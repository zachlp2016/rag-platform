  "invalid_cases": [
    {
      "name": "utility_model_cannot_select_source",
      "mutation": {
        "operation": "replace",
        "path": [
          "source",
          "method"
        ],
        "value": "utility_model"
      },
      "expected_error": "source_authority_violation"
    },
    {
      "name": "corpus_cannot_name_file",
      "mutation": {
        "operation": "replace",
        "path": [
          "source",
          "source_id"
        ],
        "value": "annual_report.pdf"
      },
      "expected_error": "invalid_source"
    },
    {
      "name": "file_requires_source_id",
      "mutations": [
        {
          "operation": "replace",
          "path": [
            "source",
            "scope"
          ],
          "value": "file"
        },
        {
          "operation": "replace",
          "path": [
            "source",
            "source_id"
          ],
          "value": null
        }
      ],
      "expected_error": "invalid_identifier"
    },
    {
      "name": "raw_query_is_not_part_of_envelope",
      "mutation": {
        "operation": "add",
        "path": [
          "query"
        ],
        "value": "private user query"
      },
      "expected_error": "unknown_field"
    },
    {
      "name": "decision_cannot_be_persisted",
      "mutation": {
        "operation": "replace",
        "path": [
          "lifecycle",
          "persist_decision"
        ],
        "value": true
      },
      "expected_error": "invalid_lifecycle"
    },
    {
      "name": "raw_query_logging_cannot_be_enabled",
      "mutation": {
        "operation": "replace",
        "path": [
          "lifecycle",
          "log_raw_query"
        ],
        "value": true
      },
      "expected_error": "invalid_lifecycle"
    },
    {
      "name": "budget_must_be_positive",
      "mutation": {
        "operation": "replace",
        "path": [
          "depth",
          "evidence_budget_tokens"
        ],
        "value": 0
      },
      "expected_error": "invalid_integer"
    },
    {
      "name": "facet_count_must_include_primary",
      "mutation": {
        "operation": "replace",
        "path": [
          "depth",
          "facet_count"
        ],
        "value": 0
      },
      "expected_error": "invalid_integer"
    },
    {
      "name": "unknown_depth_tier",
      "mutation": {
        "operation": "replace",
        "path": [
          "depth",
          "tier"
        ],
        "value": "file_focused"
      },
      "expected_error": "invalid_depth"
    },
    {
      "name": "confidence_is_bounded",
      "mutation": {
        "operation": "replace",
        "path": [
          "depth",
          "confidence"
        ],
        "value": 1.01
      },
      "expected_error": "invalid_confidence"
    },
    {
      "name": "reason_codes_are_unique",
      "mutation": {
        "operation": "replace",
        "path": [
          "depth",
          "reason_codes"
        ],
        "value": [
          "multi_facet_synthesis",
          "multi_facet_synthesis"
        ]
      },
      "expected_error": "invalid_reason_codes"
    },
    {
      "name": "reason_codes_cannot_be_empty",
      "mutation": {
        "operation": "replace",
        "path": [
          "source",
          "reason_codes"
        ],
        "value": []
      },
      "expected_error": "invalid_reason_codes"
    },
    {
      "name": "depth_method_is_versioned",
      "mutation": {
        "operation": "replace",
        "path": [
          "depth",
          "method"
        ],
        "value": "classifier"
      },
      "expected_error": "invalid_depth"
    }
  ]
}
